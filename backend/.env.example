# ==================================================================
# 环境变量示例文件（不含任何敏感信息，可安全提交 / 开源）
#
# 使用方法：
#   1. 复制本文件为 .env（在 backend 目录执行：cp .env.example .env）
#   2. 按各项注释填写配置（标 ★ 的为必填项）
#   3. .env 已被 .gitignore 忽略，不会进入版本库
#   4. 修改 .env 后需重启后端服务才会生效
# ==================================================================

# ========== DeepSeek 配置（必填） ==========
# 申请地址：https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=sk-请填入你的DeepSeekKey
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ========== 服务配置 ==========
APP_NAME=AI 闯关学习
APP_ENV=development
DEBUG=true
# 允许的跨域来源，多个用逗号分隔；开发期用 *
CORS_ORIGINS=*

# ========== LLM 调用参数 ==========
QUIZ_TEMPERATURE=0.4
REPORT_TEMPERATURE=0.5
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ========== 数据库（MySQL） ==========
# 本机 MySQL 默认：127.0.0.1:3306 / 用户 root / 库 ai_quiz（两库需先创建，见 scripts/init_db.sql）
# ★ 只需填写 DB_PASSWORD；其余字段有需要时再补
DB_PASSWORD=你的MySQL密码

# ========== 登录鉴权（必填） ==========
# JWT 签名密钥：随机字符串（生成命令：python -c "import secrets; print(secrets.token_hex(32))"）
JWT_SECRET=请填入随机密钥
JWT_EXPIRE_DAYS=30

# ========== 微信小程序登录（可选） ==========
# 获取方式：微信公众平台 https://mp.weixin.qq.com → 开发管理 → 开发设置 → 查看 AppID / 生成 AppSecret
# 填写后：小程序端自动走真实微信登录（/auth/login），无需改其他代码
WECHAT_APPID=你的AppID
WECHAT_SECRET=你的AppSecret
# true=开放「开发态模拟登录」接口（dev-login，供 H5 调试或未配置微信时使用）
# 开发阶段建议保持 true；正式上线前请改为 false
AUTH_MOCK_ENABLED=true

# ========== 知识获取：Tavily 联网搜索增强（可选） ==========
# 申请地址：https://app.tavily.com → API Keys（免费额度 1000 credits/月）
# ★ 留空 = 不启用联网检索：出题行为与升级前完全一致（纯模型知识）
#   填入后（tvly- 开头）：出题前由 AI Agent 联网检索 / 提取网页作为出题依据，新概念也能出对题
#   修改后需重启后端生效；回滚 = 清空此项
TAVILY_API_KEY=
# 以下为可选调优项（代码有默认值，一般无需填写）：
# SEARCH_COUNTRY=                # 检索结果地域偏向（如 china；留空 = 不偏向；仅 general 主题生效）
# SEARCH_AUTO_PARAMETERS=true    # deep 档允许 Tavily 自动配置参数（可能升级 advanced，约 2 credits/次）
# SEARCH_AGENT_TIMEOUT_SECONDS=45
# SEARCH_AGENT_MAX_TOOL_CALLS=4
# SEARCH_MAX_RESULTS=10          # 轻快档搜索结果条数（深度档固定 5 条完整内容）
# SEARCH_SUMMARY_MAX_CHARS=5000
# ASSESSMENT_TIMEOUT_SECONDS=20  # 知识可靠性评估调用超时
# TASK_TTL_HOURS=24              # 生成任务保留时长（超期懒清理）
# TASK_WORKER_CONCURRENCY=2      # 生成任务执行线程池并发数

# ========== RAG 资料库：上传文档 → 出题检索增强（可选） ==========
# 申请地址：https://bailian.console.aliyun.com → API-KEY 管理（新用户有免费额度）
# ★ 留空 = 不启用资料库：上传入口提示未启用，出题行为与升级前完全一致
#   填入后：支持上传 PDF / Word / Markdown → 自动解析分块向量化入库；
#   出题时 AI Agent 自主检索资料库（优先采用），资料不足时联网搜索补充
#   修改后需重启后端生效；回滚 = 清空此项
DASHSCOPE_API_KEY=
# 以下为可选调优项（代码有默认值，一般无需填写）：
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSIONS=1024        # 向量维度（与已建向量库绑定，变更需重建）
# EMBEDDING_BATCH_SIZE=10          # 单请求条数（对齐百炼官方上限 10）
# KB_SIMILARITY_THRESHOLD=0.58     # 检索相关度阈值（cosine 距离；2026-10-07 实测标定）
# KB_TOP_K=5                       # 单次检索返回片段数
# KB_CHUNK_SIZE=500                # 文本分块大小（字符）
# KB_CHUNK_OVERLAP=50              # 相邻分块重叠（字符）
# UPLOAD_MAX_SIZE_MB=20            # 单个文件大小上限（MB）
# CHROMA_DIR=                      # 向量库目录（留空 = backend/data/chroma）
# UPLOAD_DIR=                      # 上传文件目录（留空 = backend/data/uploads）
# KB_SNIPPET_MAX_CHARS=1200        # 单条命中注入 Agent 提示词的截断上限（字符）
# DOC_WORKER_CONCURRENCY=1         # 文档处理线程池并发数
