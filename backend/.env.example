# ========== DeepSeek 配置 ==========
# 复制本文件为 .env 并填入真实 Key（.env 已被 gitignore，不会提交）
DEEPSEEK_API_KEY=sk-请填入你的DeepSeekKey
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ========== 服务配置 ==========
APP_NAME=AI 闯关学习
APP_ENV=development
DEBUG=true
# 允许的跨域来源，多个用逗号分隔；开发期用 *
CORS_ORIGINS=*

# ========== LLM 调用参数 ==========
QUIZ_TEMPERATURE=0.4
REPORT_TEMPERATURE=0.5
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
