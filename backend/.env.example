# ========== DeepSeek 配置 ==========
# 复制本文件为 .env 并填入真实 Key（.env 已被 gitignore，不会提交）
DEEPSEEK_API_KEY=sk-请填入你的DeepSeekKey
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ========== 服务配置 ==========
APP_NAME=AI 闯关学习
APP_ENV=development
DEBUG=true
# 允许的跨域来源，多个用逗号分隔；开发期用 *
CORS_ORIGINS=*

# ========== LLM 调用参数 ==========
QUIZ_TEMPERATURE=0.4
REPORT_TEMPERATURE=0.5
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ========== 数据库（MySQL） ==========
# 本机 MySQL 默认：127.0.0.1:3306 / 用户 root / 库 ai_quiz（两库需先创建，见 scripts/init_db.sql）
# ★ 只需填写 DB_PASSWORD；其余字段有需要时再补
DB_PASSWORD=你的MySQL密码

# ========== 登录鉴权 ==========
# JWT 签名密钥：随机字符串（生成命令：python -c "import secrets; print(secrets.token_hex(32))"）
JWT_SECRET=请填入随机密钥
JWT_EXPIRE_DAYS=30

# ========== 微信小程序（可选） ==========
# 注册小程序测试号/正式号后填入 AppID/AppSecret，并将 AUTH_MOCK_ENABLED 置为 false
WECHAT_APPID=
WECHAT_SECRET=
# true=开启开发态模拟登录（仅本地调试用）
AUTH_MOCK_ENABLED=true
